{
  "name": "@typemint/scalars",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/typemint-dev/typemint.git"
  },
  "author": "Ales Albert Kilbergr <ales.albert@kilbergr.eu>",
  "description": "Environment-agnostic scalar types and utilities for TypeScript.",
  "keywords": [
    "typemint",
    "scalars",
    "typescript",
    "utilities"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "browser": "./dist/index.js",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:esm": "tsup --format esm",
    "build:cjs": "tsup --format cjs",
    "dev": "tsup --watch",
    "test": "vitest --run --dir src --passWithNoTests",
    "test:coverage": "vitest --run --dir src --coverage --passWithNoTests",
    "lint": "oxlint src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "typecheck": "tsc --noEmit",
    "precommit:check": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm build && pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "@typemint/core": "^0.16.2",
    "@typemint/data": "^0.11.0",
    "@typemint/result": "^0.3.0"
  }
}
